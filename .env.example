# ── Aura environment ────────────────────────────────────────────────────────────
# Copy to .env (backend) or .env.worker (worker). Never commit real values.

# App
APP_ENV=dev                      # dev | test | prod
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Database (Neon: pooled string for the API, direct string for migrations)
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura
DIRECT_DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura

# Auth
JWT_SECRET=change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=aura-audio
R2_BUCKET_ART=aura-art
R2_ENDPOINT_URL=

# Worker
WORKER_TOKEN=change-me-32-bytes-minimum
WORKER_POLL_SECONDS=25
WORKER_CONCURRENCY=1

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=INFO

# AI (optional, phase 14)
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=5.00

# Tests (optional; integration tests are skipped without it)
AURA_TEST_DATABASE_URL=
